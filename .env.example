# =============================================================================
# Multi-Agent Academic Paper Analysis System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys
# At minimum, you need ONE LLM provider API key

# =============================================================================
# LLM Provider API Keys (You need at least ONE)
# =============================================================================

# Groq API - Fast and free tier available
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API - GPT-4, GPT-3.5
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API - Claude models
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google AI API - Gemini models
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=

# DeepSeek API - deepseek-chat / deepseek-reasoner (very cheap, OpenAI-compatible)
# Get your key at: https://platform.deepseek.com/api_keys
# Uses langchain-deepseek if installed, else falls back to the OpenAI-compatible
# endpoint via langchain-openai. To run on DeepSeek: LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# =============================================================================
# LLM Settings (Optional - auto-detected if not set)
# =============================================================================

# Force a specific provider: groq, openai, anthropic, google, deepseek
# (If multiple keys are set, the provider is auto-detected unless you set this.)
# LLM_PROVIDER=groq

# Override the default model for your provider. Examples:
#   groq:      llama-3.3-70b-versatile
#   anthropic: claude-haiku-4-5   (fast/cheap)  |  claude-opus-4-8 (best)
#   openai:    gpt-4o-mini
# To run on Claude Haiku, set:  LLM_PROVIDER=anthropic
# LLM_MODEL=llama-3.3-70b-versatile

# Temperature for text generation (0.0 - 1.0)
# LLM_TEMPERATURE=0.1

# =============================================================================
# Search API Keys (Optional - enhances search results)
# =============================================================================

# SerpAPI - For enhanced Google Scholar search
# Get your key at: https://serpapi.com/
SERPAPI_API_KEY=

# Semantic Scholar API - For higher rate limits
# Get your key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# CORE API - Open-access aggregator (full-text + theses). Optional:
# anonymous access works but is rate-limited. Get a key for higher limits.
# Get your key at: https://core.ac.uk/services/api
CORE_API_KEY=

# =============================================================================
# Supplementary Resources (GitHub repos, Medium articles, YouTube videos)
# =============================================================================
# These return only REAL, verifiable items (or nothing) — never AI-generated.

# GitHub: works without a token (low rate limit). Add a token for higher limits.
# Create one at: https://github.com/settings/tokens (no scopes needed for search)
GITHUB_TOKEN=
# Minimum stars for a repo to be shown (default: 100)
# GITHUB_MIN_STARS=100

# YouTube Data API key — videos are omitted entirely if this is not set.
# Get your key at: https://console.cloud.google.com/ (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Turn the whole supplementary-resources step on/off (default: on)
# ENABLE_RESOURCES=1

# =============================================================================
# Search Settings (Optional)
# =============================================================================

# Maximum results from each source (default: 15)
# MAX_RESULTS_PER_SOURCE=15

# Maximum number of search queries to generate (default: 12)
# Lower = more focused/on-topic & faster; higher = broader recall but more drift.
# MAX_SEARCH_QUERIES=12

# Active sources, comma-separated
# (default: arxiv,semantic_scholar,openalex,openalex_thesis,core,crossref,doaj,dblp)
# Supported:
#   arxiv, semantic_scholar, openalex   -> papers
#   openalex_thesis                     -> PhD/Master's theses (any language, incl. Turkish)
#   core                                -> open-access full text + theses (multilingual)
#   crossref                            -> DOI metadata + citation counts (~150M works)
#   doaj                                -> open-access journal articles
#   dblp                                -> computer-science bibliography
#   openaire                            -> European open-access aggregator (optional)
#   pubmed                              -> biomedical (optional)
#   yoktez                              -> YÖK Ulusal Tez Merkezi (Turkish theses, best-effort)
# SOURCES=arxiv,semantic_scholar,openalex,openalex_thesis,core,crossref,doaj,dblp

# Multilingual search: generate queries in both English and Turkish (default: 1/on)
# BILINGUAL_SEARCH=1
# Target languages for query generation, comma-separated ISO codes (default: en,tr)
# SEARCH_LANGUAGES=en,tr

# =============================================================================
# LLM Reranking (language-agnostic relevance) — recommended: run on Haiku
# =============================================================================
# Re-scores the top candidates by how relevant they REALLY are to the topic,
# regardless of language, and drops off-topic papers (keyword relevance is biased
# toward the query's language). Strongly improves on-topic precision.
# ENABLE_RERANK=1
# RERANK_TOP_K=50            # how many candidates to rerank
# RELEVANCE_MIN=40           # drop papers scored below this (0-100); 0 = keep all
# Run reranking on a separate model/quota (e.g. Haiku) without changing the main
# provider — useful when the main provider (e.g. Groq) hits daily token limits:
# RERANK_PROVIDER=anthropic
# RERANK_MODEL=claude-haiku-4-5

# Number of worker threads for concurrent searching (default: 8)
# SEARCH_MAX_WORKERS=8

# Limit Semantic Scholar / PubMed to the first N queries to avoid rate limits (default: 5)
# SEMANTIC_SCHOLAR_QUERY_LIMIT=5

# =============================================================================
# LangSmith Tracing (Optional - for debugging and monitoring)
# =============================================================================

# Enable LangSmith tracing
# LANGCHAIN_TRACING_V2=true

# Your LangSmith API key
# Get your key at: https://smith.langchain.com/
# LANGCHAIN_API_KEY=

# Project name for organizing traces
# LANGCHAIN_PROJECT=academic-paper-analysis

# =============================================================================
# Diagnostics & Evaluation (Optional)
# =============================================================================

# Logging verbosity for diagnostics: DEBUG, INFO, WARNING, ERROR (default WARNING)
# DEEPARTICLE_LOG_LEVEL=WARNING

# API response caching (speeds up repeat searches, avoids rate limits)
# Disable caching entirely:
# DEEPARTICLE_NO_CACHE=1
# Cache time-to-live in seconds (default: 604800 = 7 days)
# DEEPARTICLE_CACHE_TTL=604800

# Opt out of DeepEval anonymous telemetry when running the eval suite
# DEEPEVAL_TELEMETRY_OPT_OUT=YES
